    status: "Pronto",
    runs: 12,
    lastRun: "Nunca executado nesta sessão",
  },
  {
    id: "FLOW-002",
    name: "Avaliação de fornecedores",
    description:
      "Prepara uma comparação de fornecedores sem enviar pedidos reais.",
    category: "Fornecedores",
    modules: ["Supplier AI", "Analytics AI"],
    status: "Pronto",
    runs: 8,
    lastRun: "Nunca executado nesta sessão",
  },
  {
    id: "FLOW-003",
    name: "Preparação de campanha",
    description:
      "Organiza ideias, criativos e métricas para uma campanha simulada.",
    category: "Marketing",
    modules: ["Creative AI", "Ads AI"],
