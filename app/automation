
"use client";

import { useMemo, useState } from "react";
import {
  Activity,
  AlertCircle,
  ArrowDownRight,
  ArrowRight,
  ArrowUpRight,
  Bot,
  Check,
  CheckCircle2,
  ChevronDown,
  CirclePlay,
  Clock3,
  Filter,
  History,
  Layers3,
  LockKeyhole,
  Pause,
  Play,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  Sparkles,
  Workflow,
  XCircle,
  Zap,
} from "lucide-react";

type FlowStatus = "Pronto" | "Em pausa" | "Concluído";
type FlowCategory =
  | "Pesquisa"
  | "Fornecedores"
  | "Marketing"
  | "Vendas"
  | "Finanças"
  | "Monitorização";

type AutomationFlow = {
  id: string;
  name: string;
  description: string;
  category: FlowCategory;
  modules: string[];
  status: FlowStatus;
  runs: number;
  lastRun: string;
};

type HistoryEntry = {
  id: string;
  flowName: string;
  message: string;
  time: string;
  status: "Sucesso" | "Aviso" | "Bloqueado";
};

const initialFlows: AutomationFlow[] = [
  {
    id: "FLOW-001",
    name: "Pesquisa de oportunidades",
    description:
      "Organiza produtos candidatos e prepara resultados para revisão.",
    category: "Pesquisa",
