    name: "Verificação dos módulos",
    description:
      "Prepara uma lista de verificações para acompanhar o estado do sistema.",
    category: "Monitorização",
    modules: ["Monitoring AI", "Supervisor AI"],
    status: "Pronto",
    runs: 14,
    lastRun: "Nunca executado nesta sessão",
  },
];

const categories = [
  "Todas",
  "Pesquisa",
  "Fornecedores",
  "Marketing",
  "Vendas",
  "Finanças",
  "Monitorização",
] as const;

type CategoryFilter = (typeof categories)[number];

const categoryStyles: Record<FlowCategory, string> = {
  Pesquisa: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  Fornecedores: "bg-violet-500/10 text-violet-400 border-violet-500/20",
  Marketing: "bg-pink-500/10 text-pink-400 border-pink-500/20",
  Vendas: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  Finanças: "bg-amber-500/10 text-amber-400 border-amber-500/20",
  Monitorização: "bg-cyan-500/10 text-cyan-400 border-cyan-500/20",
};

function createHistoryEntry(
  flow: AutomationFlow,
  status: HistoryEntry["status"],
  message: string,
): HistoryEntry {
  return {
    id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
    flowName: flow.name,
    message,
    time: new Date().toLocaleString("pt-PT"),
    status,
  };
}

export default function AutomationPage() {
  const [flows, setFlows] = useState<AutomationFlow[]>(initialFlows);
  const [history, setHistory] = useState<HistoryEntry[]>([]);
  const [query, setQuery] = useState("");
  const [category, setCategory] = useState<CategoryFilter>("Todas");
  const [statusFilter, setStatusFilter] = useState("Todos");
  const [selectedFlow, setSelectedFlow] = useState<string | null>(null);
  const [showNewFlow, setShowNewFlow] = useState(false);
  const [newName, setNewName] = useState("");
  const [newDescription, setNewDescription] = useState("");
  const [newCategory, setNewCategory] =
    useState<FlowCategory>("Pesquisa");
  const [notice, setNotice] = useState<string | null>(null);

  const filteredFlows = useMemo(() => {
    const normalizedQuery = query.trim().toLowerCase();

    return flows.filter((flow) => {
      const matchesQuery =
        !normalizedQuery ||
        flow.name.toLowerCase().includes(normalizedQuery) ||
        flow.description.toLowerCase().includes(normalizedQuery) ||
        flow.modules.some((module) =>
          module.toLowerCase().includes(normalizedQuery),
        );

      const matchesCategory =
        category === "Todas" || flow.category === category;

      const matchesStatus =
        statusFilter === "Todos" || flow.status === statusFilter;

      return matchesQuery && matchesCategory && matchesStatus;
    });
  }, [flows, query, category, statusFilter]);

  const selected = flows.find((flow) => flow.id === selectedFlow);

  const completedRuns = history.filter(
    (entry) => entry.status === "Sucesso",
  ).length;

  const blockedRuns = history.filter(
    (entry) => entry.status === "Bloqueado",
  ).length;

  function runSimulation(flow: AutomationFlow) {
    if (flow.status === "Em pausa") {
      setNotice("Este fluxo está em pausa. Retoma-o antes de testar.");
      return;
    }

    const entry = createHistoryEntry(
      flow,
      "Sucesso",
      "Simulação concluída. Nenhuma ação externa foi executada.",
    );

    setHistory((previous) => [entry, ...previous].slice(0, 50));

    setFlows((previous) =>
      previous.map((item) =>
        item.id === flow.id
          ? {
              ...item,
              runs: item.runs + 1,
              lastRun: new Date().toLocaleString("pt-PT"),
            }
          : item,
      ),
    );

    setNotice(`Simulação concluída: ${flow.name}.`);
  }

  function togglePause(flow: AutomationFlow) {
    const nextStatus: FlowStatus =
      flow.status === "Em pausa" ? "Pronto" : "Em pausa";

    setFlows((previous) =>
      previous.map((item) =>
        item.id === flow.id ? { ...item, status: nextStatus } : item,
      ),
    );

    setNotice(
      nextStatus === "Em pausa"
        ? `Fluxo pausado: ${flow.name}.`
        : `Fluxo retomado: ${flow.name}.`,
    );
  }

  function createFlow() {
    const name = newName.trim();
    const description = newDescription.trim();

    if (!name || !description) {
      setNotice("Preenche o nome e a descrição do fluxo.");
      return;
    }

    const flow: AutomationFlow = {
      id: `FLOW-${String(Date.now()).slice(-6)}`,
      name,
      description,
      category: newCategory,
      modules: ["A definir"],
      status: "Pronto",
      runs: 0,
      lastRun: "Nunca executado",
    };

    setFlows((previous) => [flow, ...previous]);
    setSelectedFlow(flow.id);
    setNewName("");
    setNewDescription("");
    setShowNewFlow(false);
    setCategory("Todas");
    setStatusFilter("Todos");
    setQuery("");
    setNotice("Novo fluxo criado localmente para simulação.");
  }

  function clearHistory() {
    setHistory([]);
    setNotice("Histórico desta sessão limpo.");
  }

  return (
    <main className="min-h-screen bg-[#080b14] text-slate-100">
      <div className="mx-auto max-w-7xl space-y-7 px-4 py-6 sm:px-6 lg:px-8 lg:py-9">
        <header className="flex flex-col justify-between gap-5 md:flex-row md:items-center">
          <div className="flex items-start gap-4">
            <div className="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10">
              <Workflow className="h-7 w-7 text-cyan-400" />
            </div>
            <div>
              <div className="mb-2 flex flex-wrap items-center gap-2">
                <span className="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-2.5 py-1 text-xs font-semibold text-cyan-300">
                  MÓDULO  ·  AUTOMATION AI
                </span>
                <span className="flex items-center gap-1.5 rounded-full border border-amber-400/20 bg-amber-400/10 px-2.5 py-1 text-xs text-amber-300">
                  <span className="h-1.5 w-1.5 rounded-full bg-amber-400" />
                  Modo de simulação
                </span>
              </div>
              <h1 className="text-2xl font-bold tracking-tight sm:text-3xl">
                Centro de automação
              </h1>
              <p className="mt-1 max-w-2xl text-sm leading-6 text-slate-400">
                Coordena fluxos, acompanha execuções e mantém as ações
                externas sob controlo.
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={() => setShowNewFlow((value) => !value)}
            className="inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-400 px-4 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-300"
          >
            {showNewFlow ? (
              <XCircle className="h-4 w-4" />
            ) : (
              <Plus className="h-4 w-4" />
            )}
            {showNewFlow ? "Cancelar" : "Novo fluxo"}
          </button>
        </header>

        {notice && (
          <div
            role="status"
            className="flex items-start justify-between gap-3 rounded-xl border border-cyan-400/20 bg-cyan-400/5 px-4 py-3 text-sm text-cyan-100"
          >
            <div className="flex items-start gap-2">
              <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-cyan-400" />
              <span>{notice}</span>
            </div>
            <button
              type="button"
              aria-label="Fechar aviso"
              onClick={() => setNotice(null)}
              className="text-slate-400 hover:text-white"
            >
              <XCircle className="h-4 w-4" />
            </button>
          </div>
        )}

        <section className="rounded-2xl border border-amber-400/20 bg-amber-400/[0.045] p-4 sm:p-5">
          <div className="flex items-start gap-3">
            <div className="rounded-xl bg-amber-400/10 p-2.5">
              <ShieldCheck className="h-5 w-5 text-amber-300" />
            </div>
            <div className="min-w-0 flex-1">
              <h2 className="font-semibold text-amber-100">
                Proteção de ações externas ativa
              </h2>
              <p className="mt-1 text-sm leading-6 text-slate-400">
                Os testes abaixo atualizam apenas o estado desta página.
                Não ligam APIs, não guardam dados na base de dados e não
                executam compras, pagamentos, anúncios ou mensagens reais.
              </p>
            </div>
            <LockKeyhole className="hidden h-5 w-5 shrink-0 text-amber-300 sm:block" />
          </div>
        </section>

        {showNewFlow && (
          <section className="rounded-2xl border border-cyan-400/20 bg-[#0d1220] p-5 sm:p-6">
            <div className="mb-5 flex items-center gap-3">
              <div className="rounded-xl bg-cyan-400/10 p-2.5">
                <Plus className="h-5 w-5 text-cyan-300" />
              </div>
              <div>
                <h2 className="font-semibold">Criar fluxo de automação</h2>
                <p className="text-sm text-slate-400">
                  O novo fluxo fica disponível nesta sessão.
                </p>
              </div>
            </div>

            <div className="grid gap-4 md:grid-cols-2">
              <label className="space-y-2 text-sm">
                <span className="text-slate-300">Nome do fluxo</span>
                <input
                  value={newName}
                  onChange={(event) => setNewName(event.target.value)}
                  placeholder="Ex.: Análise semanal de produtos"
                  maxLength={90}
                  className="w-full rounded-xl border border-white/10 bg-[#080b14] px-4 py-3 text-white outline-none placeholder:text-slate-600 focus:border-cyan-400/60"
                />
              </label>

              <label className="space-y-2 text-sm">
                <span className="text-slate-300">Categoria</span>
                <div className="relative">
                  <select
                    value={newCategory}
                    onChange={(event) =>
                      setNewCategory(event.target.value as FlowCategory)
                    }
                    className="w-full appearance-none rounded-xl border border-white/10 bg-[#080b14] px-4 py-3 text-white outline-none focus:border-cyan-400/60"
                  >
                    {categories
                      .filter(
                        (item): item is FlowCategory => item !== "Todas",
                      )
                      .map((item) => (
                        <option key={item} value={item}>
                          {item}
                        </option>
                      ))}
                  </select>
                  <ChevronDown className="pointer-events-none absolute right-3 top-3.5 h-4 w-4 text-slate-500" />
                </div>
              </label>

              <label className="space-y-2 text-sm md:col-span-2">
                <span className="text-slate-300">Descrição</span>
                <textarea
                  value={newDescription}
                  onChange={(event) =>
                    setNewDescription(event.target.value)
                  }
                  placeholder="Explica o objetivo e o resultado esperado..."
                  rows={3}
                  maxLength={400}
                  className="w-full resize-y rounded-xl border border-white/10 bg-[#080b14] px-4 py-3 text-white outline-none placeholder:text-slate-600 focus:border-cyan-400/60"
                />
              </label>
            </div>

            <div className="mt-4 flex flex-wrap justify-end gap-3">
              <button
                type="button"
                onClick={() => setShowNewFlow(false)}
                className="rounded-xl border border-white/10 px-4 py-2.5 text-sm text-slate-300 hover:bg-white/5"
              >
                Cancelar
              </button>
              <button
                type="button"
                onClick={createFlow}
                className="inline-flex items-center gap-2 rounded-xl bg-cyan-400 px-4 py-2.5 text-sm font-bold text-slate-950 hover:bg-cyan-300"
              >
                <Check className="h-4 w-4" />
                Criar fluxo
              </button>
            </div>
          </section>
        )}

        <section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <MetricCard
            title="Fluxos disponíveis"
            value={String(flows.length)}
            subtitle="Fluxos nesta sessão"
            icon={<Layers3 className="h-5 w-5" />}
            trend="Gestão local"
          />
          <MetricCard
            title="Execuções simuladas"
            value={String(history.length)}
            subtitle="Nesta sessão"
            icon={<Activity className="h-5 w-5" />}
            trend="Sem chamadas externas"
          />
          <MetricCard
            title="Simulações concluídas"
            value={String(completedRuns)}
            subtitle="Registos com sucesso"
            icon={<CheckCircle2 className="h-5 w-5" />}
            trend="Sessão atual"
          />
          <MetricCard
            title="Ações bloqueadas"
            value={String(blockedRuns)}
            subtitle="Registos de bloqueio"
            icon={<LockKeyhole className="h-5 w-5" />}
            trend="Proteção ativa"
          />
        </section>

        <section className="grid gap-5 xl:grid-cols-[minmax(0,1.65fr)_minmax(280px,0.8fr)]">
          <div className="min-w-0 space-y-4">
            <div className="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
              <div>
                <h2 className="text-lg font-bold">Fluxos de trabalho</h2>
                <p className="mt-1 text-sm text-slate-400">
                  Seleciona um fluxo para consultar ou testar.
                </p>
              </div>
              <span className="text-sm text-slate-500">
                {filteredFlows.length} resultado(s)
              </span>
            </div>

            <div className="flex flex-col gap-3 sm:flex-row">
              <div className="relative flex-1">
                <Search className="absolute left-3 top-3 h-4 w-4 text-slate-500" />
                <input
                  value={query}
                  onChange={(event) => setQuery(event.target.value)}
                  placeholder="Pesquisar fluxos ou módulos..."
                  className="w-full rounded-xl border border-white/10 bg-[#0d1220] py-2.5 pl-10 pr-4 text-sm text-white outline-none placeholder:text-slate-600 focus:border-cyan-400/50"
                />
              </div>

              <div className="relative sm:w-44">
                <Filter className="pointer-events-none absolute left-3 top-3 h-4 w-4 text-slate-500" />
                <select
                  value={statusFilter}
                  onChange={(event) => setStatusFilter(event.target.value)}
                  className="w-full appearance-none rounded-xl border border-white/10 bg-[#0d1220] py-2.5 pl-9 pr-8 text-sm text-white outline-none focus:border-cyan-400/50"
                >
                  <option value="Todos">Todos os estados</option>
                  <option value="Pronto">Pronto</option>
                  <option value="Em pausa">Em pausa</option>
                  <option value="Concluído">Concluído</option>
                </select>
                <ChevronDown className="pointer-events-none absolute right-3 top-3 h-4 w-4 text-slate-500" />
              </div>
            </div>

            <div className="flex gap-2 overflow-x-auto pb-1">
              {categories.map((item) => (
                <button
                  key={item}
                  type="button"
                  onClick={() => setCategory(item)}
                  className={`shrink-0 rounded-lg border px-3 py-2 text-xs font-medium transition ${
                    category === item
                      ? "border-cyan-400/40 bg-cyan-400/10 text-cyan-300"
                      : "border-white/10 bg-[#0d1220] text-slate-400 hover:text-white"
                  }`}
                >
                  {item}
                </button>
              ))}
            </div>

            <div className="space-y-3">
              {filteredFlows.map((flow) => (
                <FlowCard
                  key={flow.id}
                  flow={flow}
                  selected={selectedFlow === flow.id}
                  onSelect={() => setSelectedFlow(flow.id)}
                  onRun={() => runSimulation(flow)}
                  onTogglePause={() => togglePause(flow)}
                />
              ))}

              {filteredFlows.length === 0 && (
                <div className="rounded-2xl border border-dashed border-white/10 bg-[#0d1220] px-5 py-12 text-center">
                  <Search className="mx-auto h-8 w-8 text-slate-600" />
                  <p className="mt-3 font-medium text-slate-300">
                    Nenhum fluxo encontrado
                  </p>
                  <p className="mt-1 text-sm text-slate-500">
                    Altera a pesquisa ou os filtros.
                  </p>
                  <button
                    type="button"
                    onClick={() => {
                      setQuery("");
                      setCategory("Todas");
                      setStatusFilter("Todos");
                    }}
                    