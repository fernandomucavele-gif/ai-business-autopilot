const categories = [
  "Todos",
  "Casa",
  "Automóvel",
  "Desporto",
  "Acessórios",
  "Tecnologia",
  "Papelaria",
];

const money = (value: number) =>
  new Intl.NumberFormat("pt-MZ", {
    style: "currency",
    currency: "MZN",
    maximumFractionDigits: 0,
  }).format(value);

export default function ShopPage() {
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("Todos");
  const [cart, setCart] = useState<Record<number, number>>({});
  const [cartOpen, setCartOpen] = useState(false);
  const [selected, setSelected] = useState<Product | null>(null);
  const [mobileMenu, setMobileMenu] = useState(false);

  const filteredProducts = useMemo(
    () =>
      products.filter((product) => {
        const matchesCategory =
          category === "Todos" || product.category === category;
        const term = search.trim().toLowerCase();
        const matchesSearch =
          product.name.toLowerCase().includes(term) ||
          product.description.toLowerCase().includes(term) ||
          product.category.toLowerCase().includes(term);

        return matchesCategory && matchesSearch;
      }),
    [search, category],
  );

  const cartCount = Object.values(cart).reduce(
    (sum, quantity) => sum + quantity,
    0,
  );

  const cartItems = products.filter((product) => (cart[product.id] ?? 0) > 0);

  const total = cartItems.reduce(
    (sum, product) => sum + product.price * cart[product.id],
    0,
  );

  function changeQuantity(id: number, amount: number) {
    setCart((previous) => {
      const next = { ...previous };
      const quantity = (next[id] ?? 0) + amount;

      if (quantity <= 0) {
        delete next[id];
      } else {
        next[id] = quantity;
      }

      return next;
    });
  }

  return (
    <main className="shop">
      <div className="demo-notice">
        <ShieldCheck size={16} />
        <span>
          MODO DEMONSTRAÇÃO — produtos e preços ilustrativos. Sem pagamentos
          nem encomendas reais.
        </span>
      </div>

      <header className="shop-header">
        <a href="/shop" className="shop-logo">
          <span className="logo-mark">A</span>
          <span>
            AUTOPILOT
            <small>MARKETPLACE</small>
          </span>
        </a>

        <nav className={mobileMenu ? "shop-nav nav-open" : "shop-nav"}>
          <a href="#inicio" onClick={() => setMobileMenu(false)}>
            Início
          </a>
          <a
            href="#catalogo"
            onClick={() => setMobileMenu(false)}
          >
            Produtos
          </a>
          <a href="#sobre" onClick={() => setMobileMenu(false)}>
            Sobre a loja
          </a>
        </nav>

        <div className="header-actions">
          <button
            className="icon-button mobile-menu-button"
            onClick={() => setMobileMenu(!mobileMenu)}
            aria-label="Abrir menu"
          >
            <Menu size={21} />
          </button>
          <button
            className="cart-button"
            onClick={() => setCartOpen(true)}
          >
            <ShoppingBag size={19} />
            <span className="cart-label">Carrinho</span>
            <span className="cart-count">{cartCount}</span>
          </button>
        </div>
      </header>

      <section className="hero" id="inicio">
        <div className="hero-content">
          <span className="eyebrow">
            <Sparkles size={15} /> DESCOBRE ALGO NOVO
          </span>
          <h1>
            Compras mais simples.
            <br />
            <span>Escolhas inteligentes.</span>
          </h1>
          <p>
            Descobre produtos selecionados para a tua casa, o teu dia a dia
            e o teu estilo de vida.
          </p>
          <a href="#catalogo" className="primary-button">
            Explorar produtos <ArrowRight size={18} />
          </a>
          <div className="hero-trust">
            <ShieldCheck size={17} />
            Loja em demonstração segura
          </div>
        </div>
        <div className="hero-art">
          <div className="hero-circle">
            <ShoppingBag size={100} strokeWidth={1} />
            <span className="hero-sparkle">✳</span>
          </div>
          <div className="floating-label">
            <Sparkles size={17} />
            <span>
              <strong>Descobre</strong>
              <small>Novas possibilidades</small>
            </span>
          </div>
        </div>
      </section>

      <section className="benefits">
        <div>
          <span className="benefit-icon">✦</span>
          <span>
            <strong>Produtos selecionados</strong>
            <small>Descobre diferentes categorias</small>
          </span>
        </div>
        <div>
          <span className="benefit-icon">⌕</span>
          <span>
            <strong>Pesquisa simples</strong>
            <small>Encontra o que procuras</small>
          </span>
        </div>
        <div>
          <span className="benefit-icon">♡</span>
          <span>
            <strong>Experiência intuitiva</strong>
            <small>Compra sem complicações</small>
          </span>
        </div>
      </section>

      <section className="catalog" id="catalogo">
        <div className="section-heading">
          <div>
            <span className="eyebrow">A NOSSA SELEÇÃO</span>
            <h2>Explora os produtos</h2>
            <p>Encontra opções para as tuas necessidades.</p>
          </div>
          <span className="product-total">
            {filteredProducts.length} produtos
          </span>
        </div>

        <div className="search-box">
          <Search size={20} />
          <input
            value={search}
            onChange={(event) => setSearch(event.target.value)}
            placeholder="Pesquisar produtos..."
            aria-label="Pesquisar produtos"
          />
          {search && (
            <button onClick={() => setSearch("")} aria-label="Limpar pesquisa">
              <X size={18} />
            </button>
          )}
        </div>

        <div className="category-list">
          {categories.map((item) => (
            <button
              key={item}
              className={category === item ? "category active" : "category"}
              onClick={() => setCategory(item)}
            >
              {item}
            </button>
          ))}
        </div>

        {filteredProducts.length > 0 ? (
          <div className="product-grid">
            {filteredProducts.map((product) => (
              <article className="product-card" key={product.id}>
                <button
                  className="product-image-button"
                  onClick={() => setSelected(product)}
                  aria-label={`Ver ${product.name}`}
                >
                  <img
                    src={product.image}
                    alt={product.name}
                    className="product-image"
                  />
                  <span className="product-tag">{product.tag}</span>
                </button>
                <div className="product-info">
                  <span className="product-category">{product.category}</span>
                  <button
                    className="product-name"
                    onClick={() => setSelected(product)}
                  >
