import { NextResponse } from "next/server";
import { supabase } from "@/lib/supabase";

export async function GET() {
  const { error } = await supabase
    .from("autopilot_state")
    .select("id")
    .limit(1);

  if (error) {
    return NextResponse.json(
      {
        ok: false,
        message: "Supabase conectado, mas a tabela ainda não está disponível.",
        error: error.message,
      },
      { status: 200 }
    );
  }

  return NextResponse.json({
    ok: true,
    message: "Supabase conectado e tabela disponível.",
  });
}
