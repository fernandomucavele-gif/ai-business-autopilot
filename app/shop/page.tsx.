                setCategory("Todos");
              }}
            >
              Limpar filtros
            </button>
          </div>
        )}
      </section>

      <section className="about-shop" id="sobre">
        <Sparkles size={26} />
        <h2>Uma loja preparada para crescer</h2>
        <p>
          Esta é a primeira versão demonstrativa da loja do AI Business
          Autopilot. Os produtos e os preços são exemplos, não ofertas reais.
        </p>
      </section>

      <footer className="shop-footer">
        <a href="/shop" className="shop-logo footer-logo">
          <span className="logo-mark">A</span>
          <span>
            AUTOPILOT
            <small>MARKETPLACE</small>
          </span>
        </a>
        <span>© {new Date().getFullYear()} AI Business Autopilot</span>
        <span>Loja demonstrativa</span>
      </footer>

      {selected && (
        <div
          className="overlay"
          onClick={() => setSelected(null)}
          role="presentation"
        >
          <section
            className="dialog product-dialog"
            role="dialog"
            aria-modal="true"
            aria-label={selected.name}
            onClick={(event) => event.stopPropagation()}
          >
            <button
              className="dialog-close"
              onClick={() => setSelected(null)}
              aria-label="Fechar detalhes"
            >
              <X />
            </button>
            <img src={selected.image} alt={selected.name} />
            <div className="dialog-content">
              <span className="product-category">{selected.category}</span>
              <h2>{selected.name}</h2>
              <p>{selected.description}</p>
              <strong className="dialog-price">{money(selected.price)}</strong>
              <button
                className="primary-button full-button"
                onClick={() => {
                  changeQuantity(selected.id, 1);
                  setSelected(null);
                  setCartOpen(true);
                }}
              >
                <ShoppingBag size={18} /> Adicionar ao carrinho
              </button>
            </div>
          </section>
        </div>
      )}

      {cartOpen && (
        <div
          className="overlay"
          onClick={() => setCartOpen(false)}
          role="presentation"
        >
          <section
            className="dialog cart-dialog"
            role="dialog"
            aria-modal="true"
            aria-label="Carrinho de compras"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="cart-heading">
              <div>
                <span className="eyebrow">A TUA SELEÇÃO</span>
                <h2>O teu carrinho</h2>
              </div>
              <button
                className="dialog-close inline-close"
                onClick={() => setCartOpen(false)}
                aria-label="Fechar carrinho"
              >
                <X />
              </button>
            </div>

            {cartItems.length === 0 ? (
              <div className="empty-cart">
                <ShoppingBag size={44} />
                <h3>O teu carrinho está vazio</h3>
                <p>Explora os produtos e adiciona os teus favoritos.</p>
                <button
                  className="primary-button"
                  onClick={() => setCartOpen(false)}
                >
                  Explorar produtos
                </button>
              </div>
            ) : (
              <>
                <div className="cart-items">
                  {cartItems.map((product) => (
                    <div className="cart-item" key={product.id}>
                      <img src={product.image} alt={product.name} />
                      <div className="cart-item-info">
                        <strong>{product.name}</strong>
                        <span>{money(product.price)}</span>
                        <div className="quantity-control">
                          <button
                            onClick={() => changeQuantity(product.id, -1)}
                            aria-label="Diminuir quantidade"
                          >
                            <Minus size={15} />
                          </button>
                          <span>{cart[product.id]}</span>
                          <button
                            onClick={() => changeQuantity(product.id, 1)}
                            aria-label="Aumentar quantidade"
                          >
                            <Plus size={15} />
                          </button>
                        </div>
                      </div>
                      <strong>
                        {money(product.price * cart[product.id])}
                      </strong>
                    </div>
                  ))}
                </div>

                <div className="cart-total">
                  <span>Total demonstrativo</span>
                  <strong>{money(total)}</strong>
                </div>
                <div className="demo-checkout">
                  <ShieldCheck size={20} />
                  <p>
                    Checkout ainda não ativado. Nenhum pagamento ou encomenda
                    será efetuado.
                  </p>
                </div>
                <button
                  className="primary-button full-button"
                  onClick={() => setCartOpen(false)}
                >
                  Continuar a explorar
                </button>
              </>
            )}
          </section>
        </div>
      )}

